# Local SQLite file for development. Turso credentials replace it in production.
TURSO_DATABASE_URL=file:./local.db
# Alias aceptados para producción:
# TURSO_DATABASE_URL_PROD=libsql://...
# TURSO_AUTH_TOKEN=...
# TURSO_TOKEN=...

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Must match the origin you open in the browser.
BETTER_AUTH_URL=http://localhost:3000
